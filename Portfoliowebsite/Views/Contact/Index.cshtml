@{
    ViewData["Title"] = "Contact";
}

<h1>Contact</h1>

<form id="contactForm" asp-action="Index" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="submissionToken" value="@ViewData["SubmissionToken"]" />
    <div class="hp" aria-hidden="true" tabindex="-1">
        <label for="website">Laat dit veld leeg</label>
        <input type="text" id="website" name="website" value="" tabindex="-1" />
    </div>
    <div>
        <label for="Name">Naam</label>
        <input id="Name" name="Name" placeholder="Naam" aria-describedby="nameErr"/>
        <div id="nameErr" class="error" role="alert"></div>
    </div>
    <div>
        <label for="Email">E-mail</label>
        <input id="Email" name="Email" placeholder="naam@domein.nl" aria-describedby="emailErr" />
        <div id="emailErr" class="error" role="alert"></div>
    </div>
    <div>
        <label for="Subject">Onderwerp</label>
        <input id="Subject" name="Subject" placeholder="Onderwerp" aria-describedby="subjectErr"/>
        <div id="subjectErr" class="error" role="alert"></div>
    </div>
    <div>
        <label for="Message">Bericht</label> 
        <textarea id="Message" name="Message" rows="5" placeholder="Je bericht" aria-describedby="msgErr"></textarea>
        <div id="msgErr" class="error" role="alert"></div>
    </div>
    <div id="liveStatus" role="status" aria-live="polite" aria-atomic="true"></div>
    <button type="submit" class="send-button">
        Versturen
    </button>
</form>