﻿@{
    ViewData["Title"] = "Bedankt";
}

<h1>Bedankt!</h1>

<p>Bedankt, <span aria-label="Naam: @TempData["ThanksName"]">@Html.Raw(TempData["ThanksName"])</span>. We nemen contact op via <span aria-label="Email: @TempData["ThanksEmail"]">@Html.Raw(TempData["ThanksEmail"])</span>.</p>
<p>Je bericht:</p>
<div class="message-preview" aria-label="Je bericht inhoud: @TempData["ThanksMessage"]">@Html.Raw(TempData["ThanksMessage"])</div>

<a href="/contact">Terug naar formulier</a>